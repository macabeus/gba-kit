{
  "name": "@gba-kit/debug-core",
  "version": "0.6.0",
  "description": "IDE-agnostic GBA debugging session on top of gba-kit: breakpoints, stepping, frames and variables, rewind, tracing, and the emulator views",
  "author": "macabeus",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/macabeus/gba-kit",
    "directory": "packages/debug-core"
  },
  "homepage": "https://github.com/macabeus/gba-kit",
  "bugs": "https://github.com/macabeus/gba-kit/issues",
  "keywords": [
    "gba",
    "gameboy-advance",
    "debugger",
    "emulator",
    "dwarf",
    "typescript"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "check-types": "tsc --noEmit",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@gba-kit/arm-emulator": "workspace:*",
    "@gba-kit/debug-info": "workspace:*",
    "@gba-kit/gba-emulator": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.1"
  }
}
