{
  "name": "@gba-kit/debug-info",
  "version": "0.3.0",
  "description": "Parse ELF symbols and DWARF debug info (line tables) for GBA decomp debugging",
  "author": "macabeus",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/macabeus/gba-kit",
    "directory": "packages/debug-info"
  },
  "homepage": "https://github.com/macabeus/gba-kit",
  "bugs": "https://github.com/macabeus/gba-kit/issues",
  "keywords": [
    "gba",
    "elf",
    "dwarf",
    "debug-info",
    "decompilation",
    "typescript"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "check-types": "tsc --noEmit",
    "lint": "eslint src/"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "vitest": "^4.1.1",
    "typescript": "^6.0.2"
  }
