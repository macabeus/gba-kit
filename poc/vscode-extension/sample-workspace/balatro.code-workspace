        "cwd": "${workspaceFolder:balatro-gba}",
        "sourceMap": { "/balatro-gba": "${workspaceFolder:balatro-gba}" },
        "stopOnEntry": false,
        "outputDir": "/tmp/gba-kit-poc-out",
      },
    ],
  },
}
