{
  "folders": [
    { "name": "balatro-gba", "path": "/Users/macabeus/ApenasMeu/balatro-gba" },
    { "name": "gba-kit-scripts", "path": "./scripts" },
  ],
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "type": "gba-kit",
        "request": "launch",
        "name": "Balatro GBA (homebrew, DWARF)",
        "rom": "${workspaceFolder:balatro-gba}/build/balatro-gba.gba",
